FASTGPT_BASE_URL="填写 FastGPT 的访问地址，以 /api 结尾"
FASTGPT_API_KEY="填写 FastGPT 的 API 密钥"
FASTGPT_APP_ID="填写 FastGPT 应用详情页地址栏里的应用 ID"

DATABASE_HOST="127.0.0.1"
DATABASE_PORT="5432"
DATABASE_NAME="h2bot"
DATABASE_USER="h2bot_app"
DATABASE_PASSWORD="填写 h2bot_app 的 PostgreSQL 密码"

REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_KEY_TTL_SECONDS="600"
REDIS_USER="h2bot_app"
REDIS_PASSWORD="填写 h2bot_app 的 Redis 密码"

# 只有 1 开启调试。0 或其他值都关闭。关闭时 FastGPT 三项为空则启动失败。
DEBUG="0"
