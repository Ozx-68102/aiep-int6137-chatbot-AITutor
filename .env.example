FASTGPT_BASE_URL="填写 FastGPT 的访问地址，以 /api 结尾"
FASTGPT_API_KEY="填写 FastGPT 的 API 密钥"
FASTGPT_APP_ID="填写 FastGPT 应用详情页地址栏里的应用 ID"

# 等上游的读超时（秒）：管「等上游第一个字节」和「两块字之间」。默认 30。
FASTGPT_READ_TIMEOUT_SECONDS="30"

DATABASE_HOST="127.0.0.1"
DATABASE_PORT="5432"
DATABASE_NAME="h2bot"
DATABASE_USER="h2bot_app"
DATABASE_PASSWORD="填写 h2bot_app 的 PostgreSQL 密码"

REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_KEY_TTL_SECONDS="600"
REDIS_USER="h2bot_app"
REDIS_PASSWORD="填写 h2bot_app 的 Redis 密码"

# 只有 1 开启调试。0 或其他值都关闭。关闭时 FastGPT 三项为空则启动失败。
DEBUG="0"

# Turnstile 人机验证（登录接口）。SECRET 是 Cloudflare 控制台 widget 详情页的
# Secret Key，只在服务端 siteverify 用，绝不进前端；HOSTNAMES 是 siteverify
# 返回的前端主机名允许名单（逗号分隔）：开发用 localhost，生产换成真实域名、
# 不得包含 localhost / 127.0.0.1。缺任何一项登录都会 403（宁可挡住不放开）。
TURNSTILE_SECRET="填写 Turnstile widget 的 Secret Key"
TURNSTILE_HOSTNAMES="localhost"
