#!/usr/bin/env bash
# Conventional Commits (no scope): type: subject
# Types: feat fix chore docs refactor test ci build perf style revert
# Optional ! before : for breaking changes. Merge/fixup/squash/revert subjects skipped.
# Language: the whole message must be free of Chinese characters.

set -euo pipefail

msg_file="${1:-}"
if [[ -z "$msg_file" || ! -f "$msg_file" ]]; then
  echo "commit-msg: missing message file" >&2
  exit 1
fi

# First non-comment, non-empty line is the subject.
subject=""
while IFS= read -r line || [[ -n "$line" ]]; do
  case "$line" in
    \#*) continue ;;
  esac
  [[ -z "$line" ]] && continue
  subject="$line"
  break
done <"$msg_file"

if [[ -z "$subject" ]]; then
  echo "commit-msg: empty commit message" >&2
  exit 1
fi

# Git-generated subjects we do not rewrite-check.
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

# Language check: no Chinese characters anywhere in the message.
# Git strips "#" comment lines, so they are ignored here.
cjk_lines="$(perl -CSD -ne 'next if /^\s*#/; print "  line $.: $_" if /[\x{2E80}-\x{2EFF}\x{3000}-\x{303F}\x{3400}-\x{4DBF}\x{4E00}-\x{9FFF}\x{F900}-\x{FAFF}\x{FE30}-\x{FE4F}\x{FF00}-\x{FFEF}]/' "$msg_file" || true)"
if [[ -n "$cjk_lines" ]]; then
  {
    echo "commit-msg: commit message must not contain Chinese characters:"
    echo "$cjk_lines"
    echo "Write the message in English."
  } >&2
  exit 1
fi

pattern='^(feat|fix|chore|docs|refactor|test|ci|build|perf|style|revert)!?: .+'
if [[ ! "$subject" =~ $pattern ]]; then
  cat >&2 <<'EOF'
commit-msg: subject must be Conventional Commits with no scope:
  type: subject
Allowed types: feat fix chore docs refactor test ci build perf style revert
Optional ! before : for breaking (e.g. feat!: ...).
EOF
  exit 1
fi
